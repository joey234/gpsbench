# GPSBench .gitignore

# Environment variables and secrets
.env
.env.local
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints

# Results (keep structure, ignore generated files)
results/**/task_results/
results/**/summary.json
results/**/track_*.json
*.csv

# Data (optional - comment out if you want to commit data)
data/raw/cities15000.zip
data/raw/cities15000.txt

# Temporary files
*.tmp
*.bak
*.backup
.cache/
*.jsonl

# OS specific
Thumbs.db
.DS_Store

# Claude Code
.claude/
finetuning/tinker/tinker-cookbook/
