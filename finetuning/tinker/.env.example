# API Keys and Environment Variables for GPSBench Tinker Fine-tuning

# ============================================================
# Tinker API Key (Required for Tinker training)
# ============================================================
# Get your API key from: https://tinker-docs.thinkingmachines.ai/
# Sign up and get your key from the dashboard
TINKER_API_KEY=your_tinker_api_key_here

# Optional: Tinker endpoint (default is production)
# TINKER_API_URL=https://api.tinker.ai

# ============================================================
# Hugging Face (Required for downloading models)
# ============================================================
# Get your token from: https://huggingface.co/settings/tokens
# Required for: Downloading Qwen models and uploading fine-tuned models
HF_TOKEN=your_huggingface_token_here

# Alternative variable names (some libraries use different names)
HUGGINGFACE_TOKEN=your_huggingface_token_here
HUGGING_FACE_HUB_TOKEN=your_huggingface_token_here

# ============================================================
# Weights & Biases (Optional - for experiment tracking)
# ============================================================
# Get your key from: https://wandb.ai/authorize
# Only needed if you set wandb_project in config
WANDB_API_KEY=your_wandb_api_key_here

# Optional W&B settings
# WANDB_PROJECT=gpsbench-finetuning
# WANDB_ENTITY=your_wandb_username

# ============================================================
# OpenAI (Optional - only needed for evaluation/inference)
# ============================================================
# Get your key from: https://platform.openai.com/api-keys
# Only needed if you're using OpenAI models for comparison
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# GPU Settings (Optional)
# ============================================================
# Specify which GPU(s) to use (default: all available)
# CUDA_VISIBLE_DEVICES=0,1

# Set GPU memory fraction
# PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# ============================================================
# Logging and Debugging (Optional)
# ============================================================
# Set log level
# LOG_LEVEL=INFO

# Disable tokenizer parallelism warning
TOKENIZERS_PARALLELISM=false

# ============================================================
# Training Settings (Optional - can also be set in config.yaml)
# ============================================================
# Override training settings via environment variables
# BATCH_SIZE=64
# LEARNING_RATE=5e-4
# LORA_RANK=64
